OPENAI_API_KEY=
OPENAI_VISION_MODEL=
OPENAI_DIRECTOR_MODEL=
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# Optional; no automatic paid video generation.
GEMINI_API_KEY=
VEO_MODEL=veo-3.1-generate-preview
# A different service may use this bearer token; never expose it in browser code.
MOVIE_API_TOKEN=
# Defaults to .movie-data in MoviePart. Keep private data outside public/.
MOVIE_DATA_DIR=
# Optional executable overrides; otherwise use npm-provided local binaries.
FFMPEG_PATH=
FFPROBE_PATH=
# Optional permitted music file, stored locally and never fetched from a URL.
MOVIE_MUSIC_PATH=
# Dwight -> Tiya media service. Never expose this token to the kiosk.
MEDIA_SERVICE_TOKEN=
# Kiosk connects directly to Dwight's orchestrator at http://127.0.0.1:3101.
# Its device/session capabilities are supplied by trusted pairing, not .env.
